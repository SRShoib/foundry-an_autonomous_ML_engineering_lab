# Copy to .env and adjust as needed. Never commit the real .env file.

# --- Postgres (LangGraph checkpointer + MLflow backend share one server, two databases) ---
POSTGRES_USER=foundry
POSTGRES_PASSWORD=foundry
POSTGRES_DB=foundry
POSTGRES_PORT=5432

# Used by the host / uv-run app for the LangGraph checkpointer (database: foundry)
DATABASE_URL=postgresql://foundry:foundry@localhost:5432/foundry

# --- MLflow ---
# Host-visible tracking URI (used by scripts/tests running via `uv run`)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_PORT=5000
# Used only inside the mlflow container's own compose command (database: mlflow)
MLFLOW_BACKEND_STORE_URI=postgresql://foundry:foundry@postgres:5432/mlflow
# MLflow experiment name prefix; one experiment per dataset ("<name>-<dataset_ref>"), shared
# across foundry runs on that dataset (foundry/tools/tracker.py, M4)
MLFLOW_EXPERIMENT_NAME=foundry

# --- Sandbox (foundry/tools/sandbox.py, wired up in M2) ---
SANDBOX_IMAGE=foundry-sandbox:latest
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1
SANDBOX_PIDS_LIMIT=128
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_NETWORK_DISABLED=true

# --- Cost caps (SPEC: hard per-run cap; principal loop pauses at 80% of total spend) ---
COST_CAP_USD_TOTAL=20.0
COST_CAP_USD_PER_RUN=2.0

# --- Budget gate (foundry/teams/principal.py, foundry/gates.py, M6) ---
# est_cost_usd_per_experiment is the code-owned cost floor used before any experiment has
# completed yet (an LLM-authored ExperimentSpec.est_cost_usd is never trusted alone to decide
# whether to pause a human).
BUDGET_GATE_FRACTION=0.8
EST_COST_USD_PER_EXPERIMENT=0.25

# --- Model tier: independently configurable per role (SPEC); all default to the cheapest
# --- priced current OpenAI model (gpt-5-nano) — set principal_model/red_team_model to a
# --- stronger tier (e.g. gpt-5.5) to restore a cheap-workers/strong-principal split ---
PRINCIPAL_MODEL=gpt-5-nano
RED_TEAM_MODEL=gpt-5-nano
WORKER_MODEL=gpt-5-nano

# --- LLM interface (foundry/llm.py, M2) ---
LLM_MAX_TOKENS=8192
LLM_MAX_PARSE_RETRIES=2

# Not required for M1/M2 — the graph runs with a deterministic LLM stub until this is set
OPENAI_API_KEY=

# --- Principal loop (foundry/teams/principal.py, M3-M4) ---
PRINCIPAL_MAX_ITERATIONS=12
MAX_EXPERIMENTS_TOTAL=6
MAX_EXPERIMENTS_PER_ITERATION=3
GRAPH_RECURSION_LIMIT=40
# Caps how many Send-fanned-out experiment_runner branches (each a real docker container) run
# concurrently in one superstep (foundry/graph.py, M4)
GRAPH_MAX_CONCURRENCY=3

# --- Experiment runner self-debug (foundry/teams/experiment_runner.py, M3) ---
SELF_DEBUG_MAX_ATTEMPTS=3
SELF_DEBUG_ERROR_CHARS=4000
# M9b: sandbox stdout/stderr kept on each ExperimentResult (tail-truncated) for the console's
# experiment drawer — checkpointed state must stay small.
EXPERIMENT_OUTPUT_CHARS=4000
EXPERIMENT_TIMEOUT_SECONDS=300
PROFILE_TIMEOUT_SECONDS=120

# --- Cost model (foundry/tools/cost.py, foundry/llm.py, M4) ---
# Real OpenAI calls are priced from actual token usage against foundry/tools/cost.py's
# per-model $/token table (not env-configurable — it's published pricing, not deployment
# config); this flat rate is the StubClient-only fallback, which has no tokens to report.
COST_PER_LLM_CALL_USD=0.01
COST_PER_SANDBOX_MINUTE_USD=0.002

# --- Cross-thread lesson memory (foundry/tools/memory.py, foundry/teams/lessons.py, M7) ---
# How many of a dataset's most recent Lesson records the literature scout is shown per pass.
MEMORY_MAX_LESSONS=5

# --- Data + artifacts (M3) ---
DATA_DIR=data/samples
ARTIFACTS_DIR=artifacts
RANDOM_SEED=42

# --- FastAPI control plane (app/main.py, M6) ---
API_HOST=0.0.0.0
API_PORT=8000
# M9b: GET /runs also lists checkpointed runs from before the process started. One run writes many
# checkpoints, so a scan limit is not a run limit — both bounds are needed.
API_MAX_RUNS=25
API_CHECKPOINT_SCAN_LIMIT=2000

# --- Run recording + operator console (app/replay.py, web/, M9b) ---
# Every live run is recorded to REPLAY_RECORD_DIR (gitignored). REPLAY_DEMO_DIR holds the COMMITTED
# demo recordings; it is under web/public/ so Vite and Caddy serve it statically and the console
# replays with the API stopped, while GET /replays serves the same files to API clients.
REPLAY_RECORDING_ENABLED=true
REPLAY_DEMO_DIR=web/public/replays
REPLAY_RECORD_DIR=artifacts/replays
# `make console` serves the built console here. The API runs on the HOST (it needs the host Docker
# daemon for the sandbox), so the console container reaches it via host.docker.internal.
WEB_PORT=5174
FOUNDRY_API_UPSTREAM=host.docker.internal:8000
# `make web` (Vite dev server on :5173) proxies /api to this.
FOUNDRY_API_URL=http://localhost:8000
# M9d: the experiment drawer's MLflow link (web/src/lib/mlflow.ts). A Vite build-time var, not a
# RunStatus field — it is MLFLOW_PORT above, from the browser's point of view, not a secret.
VITE_MLFLOW_URL=http://localhost:5000

# --- LangSmith (optional, part of the SPEC's stack; not wired up until later milestones) ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=foundry
